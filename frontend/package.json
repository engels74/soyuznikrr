		"typescript": "^7.0.0",
		"unocss": "^66.6.8",
		"unocss-preset-animations": "^1.3.0",
		"unocss-preset-shadcn": "^1.0.1",
		"vite": "^8.0.10",
		"vitest": "4.1.10",
		"zod": "^4.4.2"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"dompurify": "^3.4.2",
		"marked": "^18.0.3",
		"openapi-fetch": "^0.17.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	}
